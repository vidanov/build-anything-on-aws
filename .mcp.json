{
  "mcpServers": {
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws-cli==1.7.0",
        "https://aws-mcp.eu-central-1.api.aws/mcp",
        "--profile", "baa-agent",
        "--region", "eu-central-1",
        "--read-only",
        "--metadata", "INSTALL_SOURCE=build-anything-on-aws"
      ]
    }
  }
}
